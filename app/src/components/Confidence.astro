---
/**
 * Niveau de confiance, toujours visible (US-023, D21). Annoncé en texte (pas seulement par la
 * couleur) ; un toucher mène à une explication simple sur la page À propos.
 */
import type { Confidence } from "@tongo/model";
import { t, type UiLocale } from "../i18n/ui";
interface Props { level: Confidence; locale: UiLocale }
const { level, locale } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<a class={`badge conf-${level}`} href={`${base}/${locale}/about/#confidence`} title={t(locale, `confidence.${level}.explain`)}>
  <span class="sr-only">{t(locale, "confidence.label")}{t(locale, "punct.colon")}</span>{t(locale, `confidence.${level}`)}
</a>
<style>
  .sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
  a.badge{text-decoration:none;min-height:32px}
</style>
