---
/** Transcription IPA dont chaque phonème mène à sa page Son (l'IPA comme lien de navigation, D08). */
import type { UiLocale } from "../i18n/ui";
import { t } from "../i18n/ui";
import { index } from "../lib/content";
interface Props { sound: string[]; locale: UiLocale; big?: boolean }
const { sound, locale, big } = Astro.props;
const idx = await index();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
{sound.length === 0
  ? <span class="muted">{t(locale, "char.silent")}</span>
  : <bdi class:list={["ipa", { "ipa-big": big }]} dir="ltr">/{sound.map((ipa) => {
      const p = idx.phoneme(ipa);
      return p ? <a href={`${base}/${locale}/sounds/${p.id}/`}>{ipa}</a> : <span>{ipa}</span>;
    })}/</bdi>}
