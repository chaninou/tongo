---
/** Explorer par écriture, regroupées par type (US-005). */
import Base from "../../../layouts/Base.astro";
import { UI_LOCALES, loc, t, type UiLocale } from "../../../i18n/ui";
import { content } from "../../../lib/content";
import { scriptLang } from "../../../lib/script-lang";
import { SCRIPT_TYPES } from "@tongo/model";

export function getStaticPaths() {
  return UI_LOCALES.map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as UiLocale;
const c = await content();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const groups = SCRIPT_TYPES.map((type) => ({ type, scripts: c.scripts.filter((s) => s.type === type) })).filter((g) => g.scripts.length);
---
<Base locale={locale} section="scripts" title={t(locale, "scripts.title")}>
  <h1>{t(locale, "scripts.title")}</h1>
  <p class="lead">{t(locale, "scripts.lead")}</p>
  {groups.map(({ type, scripts }) => (
    <section>
      <h2>{t(locale, `type.${type}`)}</h2>
      <p class="muted">{t(locale, `type.${type}.desc`)}</p>
      <div class="grid">
        {scripts.map((s) => (
          <a class="card" href={`${base}/${locale}/scripts/${s.id}/`}>
            <div class="sample" lang={scriptLang(s.id)}>{s.sample}</div>
            <strong>{loc(locale, s.name)}</strong>
            {s.endonym && <div class="muted" lang={scriptLang(s.id)}><bdi>{s.endonym}</bdi></div>}
          </a>
        ))}
      </div>
    </section>
  ))}
</Base>
